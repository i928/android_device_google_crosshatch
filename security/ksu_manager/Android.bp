// Dedicated cert for the baked-in KernelSU-Next manager app, so its signature
// doesn't collide with every other app resigned via default_dev_cert (that
// collision caused the kernel's manager-detection scan to crown a random
// other /product/app - e.g. Aperture - as "the manager" instead, since both
// shared the same cert). Same keystore identity as the manually-installed
// build used on other devices (~/ksu-manager-build/keystore) - see its
// README for how these files were generated.
android_app_certificate {
    name: "ksu_manager_cert",
    certificate: "ksu_manager",
}
