on post-fs-data
    mkdir /data/adb/boot-completed.d 0755 root root

    copy /system_ext/etc/data-adb-seed/daily_clean.sh /data/adb/daily_clean.sh
    chmod 0755 /data/adb/daily_clean.sh

    copy /system_ext/etc/data-adb-seed/boot-completed.d/low_battery_shutdown.sh /data/adb/boot-completed.d/low_battery_shutdown.sh
    chmod 0755 /data/adb/boot-completed.d/low_battery_shutdown.sh

    copy /system_ext/etc/data-adb-seed/boot-completed.d/daily_clean_timer.sh /data/adb/boot-completed.d/daily_clean_timer.sh
    chmod 0755 /data/adb/boot-completed.d/daily_clean_timer.sh

    # Leftovers of the crond setup (crond ran daily_clean.sh and
    # f2fs_compress.sh); daily_clean_timer.sh replaced it, as on sunfish.
    # Copies here never delete, so remove the old files once.
    rm /data/adb/boot-completed.d/start_crond.sh
    rm /data/adb/f2fs_compress.sh
    rm /data/adb/cron/crontabs/root
    rm /data/adb/cron/crond.log
    rmdir /data/adb/cron/crontabs
    rmdir /data/adb/cron
