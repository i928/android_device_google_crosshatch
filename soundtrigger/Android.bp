//
// hardware/interfaces soundtrigger@2.3 default impl, plus a fallback for the
// API 1.2 sound_trigger.primary blob.

cc_library_shared {
    name: "android.hardware.soundtrigger@2.3-impl.crosshatch",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "SoundTriggerHw.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libhidlmemory",
        "libutils",
        "libhardware",
        "android.hardware.soundtrigger@2.0",
        "android.hardware.soundtrigger@2.0-core",
        "android.hardware.soundtrigger@2.1",
        "android.hardware.soundtrigger@2.2",
        "android.hardware.soundtrigger@2.3",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
    ],
}
