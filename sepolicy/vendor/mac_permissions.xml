<?xml version="1.0" encoding="utf-8"?>
<policy>

<!--
    Assigns seinfo=mtmanager_app to bin.mt.plus (MtManager) specifically, scoped
    to this ROM's release key so no other app sharing that signature is affected.
    Paired with the seapp_contexts rule in this same directory that maps
    seinfo=mtmanager_app to domain=untrusted_app.

    signature is the DER-encoded X.509 cert, hex-encoded:
      openssl x509 -in vendor/lineage-priv/keys/releasekey.x509.pem \
        -outform DER | xxd -p | tr -d '\n'
-->
    <signer signature="" >
        <package name="bin.mt.plus" >
            <seinfo value="mtmanager_app" />
        </package>
    </signer>
</policy>
